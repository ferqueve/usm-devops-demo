# ===== UTEC SPACE MANAGER - CONFIGURACIÓN DOCKER COMPOSE (RAÍZ) =====
# Este archivo es SOLO para variables que usa docker-compose en la raíz.
# El backend usa backend/.env; el frontend usa frontend/.env.
#
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Completa los valores según tu entorno
# 3. NUNCA commitear el archivo .env (debe estar en .gitignore)

# ===== BASE DE DATOS =====
# Variables para el contenedor de PostgreSQL (y para construir SPRING_DATASOURCE_URL del backend)
POSTGRES_DB=utec_db
POSTGRES_USER=ut_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI

# ===== MINIO (contenedor) =====
# Solo si usas el servicio minio en docker-compose; el backend lee las suyas de backend/.env
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin