# ===== BASE DE DATOS =====
# Variables para el contenedor de PostgreSQL
POSTGRES_DB=utec_db
POSTGRES_USER=ut_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI