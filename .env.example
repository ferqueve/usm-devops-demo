# ===== UTEC SPACE MANAGER - CONFIGURACIÓN DOCKER COMPOSE =====
# Este archivo es una plantilla para configurar el proyecto con Docker
# 
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Completa los valores según tu entorno
# 3. NUNCA commitear el archivo .env (debe estar en .gitignore)

# ===== BASE DE DATOS =====
POSTGRES_DB=utec_db
POSTGRES_USER=ut_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO_AQUI

# ===== GOOGLE OAUTH 2.0 =====
# Obtén estas credenciales en: https://console.cloud.google.com/
# 1. Crea un proyecto
# 2. Ve a "APIs & Services" > "Credentials"
# 3. Crea "OAuth 2.0 Client ID" de tipo "Web application"
# 4. Authorized JavaScript origins: http://localhost:5173
# 5. Authorized redirect URIs: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ===== JWT (JSON Web Tokens) =====
# IMPORTANTE: Genera un secreto seguro para producción
# Puedes generar uno con: openssl rand -base64 32
JWT_SECRET=CAMBIAR_CON_SECRETO_SUPER_SEGURO_EN_PRODUCCION_MINIMO_32_CARACTERES

# ===== EMAIL (Gmail SMTP) =====
# Configuración para envío de emails de verificación
# Para Gmail, necesitas crear una "App Password":
# 1. Ve a tu cuenta de Google
# 2. Seguridad > Verificación en 2 pasos (activar)
# 3. App Passwords > Generar nueva contraseña
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# ===== FRONTEND URL =====
# URL del frontend para configurar CORS en el backend
FRONTEND_URL=http://localhost:5173

# ===== DOCKER =====
# Modo de desarrollo para el contenedor frontend
# Valores: dev (localhost) | dev:network (accesible desde red local)
DEV_MODE=dev:network