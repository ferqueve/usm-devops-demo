# Conexión a Postgres compartido con el backend.
DATABASE_URL=postgresql://ut_user:ut_pass@localhost:5432/utec_db

# Cadena de providers LLM (CSV, primero = primario). Si el primario tira error
# (típicamente 429 rate-limit), LangChain salta automático al siguiente.
# Para usar un único provider, setear LLM_PROVIDER en singular y dejar
# LLM_PROVIDERS sin definir.
LLM_PROVIDERS=gemini,groq

# Modelos por provider (uno por env var). Defaults razonables si no se setean.
LLM_MODEL_GEMINI=gemini-2.5-flash
LLM_MODEL_GROQ=llama-3.3-70b-versatile
# Alternativas con mejor function calling pero menor TPM:
#   openai/gpt-oss-120b, qwen/qwen3-32b

# Embeddings: solo Gemini (ningún provider free ofrece alternativa decente).
EMBEDDING_MODEL=gemini-embedding-001

# Credenciales — al menos una; las que correspondan a la cadena LLM_PROVIDERS.
GEMINI_API_KEY=
GROQ_API_KEY=

# Puerto del servicio HTTP.
PORT=8001
LOG_LEVEL=INFO
