# Conexión a Postgres compartido con el backend.
DATABASE_URL=postgresql://ut_user:ut_pass@localhost:5432/utec_db

# Provider LLM. Cambiar a "groq" requiere setear GROQ_API_KEY y un LLM_MODEL compatible.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Credenciales del provider (sólo el que esté en uso).
GEMINI_API_KEY=
# GROQ_API_KEY=

# Puerto del servicio HTTP.
PORT=8001
LOG_LEVEL=INFO
