# ===== UTEC SPACE MANAGER - BACKEND - DESARROLLO LOCAL =====
# Este archivo es una plantilla para desarrollo local del backend
# 
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Completa los valores según tu entorno local
# 3. NUNCA commitear el archivo .env (debe estar en .gitignore)

# ===== BASE DE DATOS LOCAL =====
# Asegúrate de tener PostgreSQL corriendo localmente
# O usa Docker: docker run --name utec_db -e POSTGRES_PASSWORD=tu_password -p 5432:5432 -d postgres:15
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/utec_db
SPRING_DATASOURCE_USERNAME=ut_user
SPRING_DATASOURCE_PASSWORD=CAMBIAR_PASSWORD_AQUI

# ===== CONFIGURACIÓN DE SPRING =====
# Perfil activo (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev
# Puerto del servidor
SERVER_PORT=8080

# ===== GOOGLE OAUTH 2.0 =====
# Obtén estas credenciales en: https://console.cloud.google.com/
# Deben ser las MISMAS credenciales que usas en el frontend
# 
# Pasos para obtener credenciales:
# 1. Ve a Google Cloud Console
# 2. Crea o selecciona un proyecto
# 3. Ve a "APIs & Services" > "Credentials"
# 4. Clic en "Create Credentials" > "OAuth 2.0 Client ID"
# 5. Tipo de aplicación: "Web application"
# 6. Authorized JavaScript origins: http://localhost:5173
# 7. Authorized redirect URIs: http://localhost:5173/auth/callback/google
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# ===== JWT (JSON Web Tokens) =====
# IMPORTANTE: En producción, usa un secreto seguro y único
# Generar secreto seguro: openssl rand -base64 64
JWT_SECRET=CAMBIAR_CON_SECRETO_SUPER_SEGURO_EN_PRODUCCION_MINIMO_32_CARACTERES
# Tiempo de expiración del Access Token en milisegundos
# 3600000 = 1 hora
JWT_EXPIRATION=3600000
# Tiempo de expiración del Refresh Token en milisegundos
# 2592000000 = 30 días
JWT_REFRESH_EXPIRATION=2592000000

# ===== EMAIL (Gmail SMTP) =====
# Configuración para envío de emails de verificación
# 
# Para configurar Gmail:
# 1. Ve a tu cuenta de Google > Seguridad
# 2. Activa "Verificación en 2 pasos"
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una nueva contraseña de aplicación
# 5. Usa esa contraseña de 16 caracteres aquí
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# ===== FRONTEND URL =====
# URL del frontend para configurar CORS
# En desarrollo local normalmente es:
FRONTEND_URL=http://localhost:5173

