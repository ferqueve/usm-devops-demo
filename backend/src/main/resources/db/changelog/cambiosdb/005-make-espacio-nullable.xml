<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Hacer espacio_id nullable para permitir desasignación -->
    <changeSet id="001" author="mathi">
        <dropNotNullConstraint tableName="inventario_item" columnName="espacio_id" columnDataType="BIGINT"/>
    </changeSet>

    <!-- Opcional: Establecer un valor por defecto o NULL para items sin espacio asignado -->
    <changeSet id="002" author="mathi">
        <sql>
            UPDATE inventario_item SET espacio_id = NULL WHERE espacio_id IS NULL OR espacio_id = 0;
        </sql>
    </changeSet>

</databaseChangeLog>

