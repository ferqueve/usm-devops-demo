<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Campos extra de tutoría: patrón, modalidad/enlace, tipo, tags, en vivo, recordatorio -->
    <changeSet id="001" author="Mathias">
        <addColumn tableName="tutoria">
            <column name="patron" type="VARCHAR(30)"/>
            <column name="modalidad" type="VARCHAR(20)" defaultValue="PRESENCIAL">
                <constraints nullable="false"/>
            </column>
            <column name="enlace" type="VARCHAR(500)"/>
            <column name="tipo" type="VARCHAR(20)" defaultValue="GRUPAL">
                <constraints nullable="false"/>
            </column>
            <column name="tags" type="VARCHAR(500)"/>
            <column name="en_vivo" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="recordatorio_enviado" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
