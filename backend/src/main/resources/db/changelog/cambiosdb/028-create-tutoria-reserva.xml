<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Reserva de una franja de tutoría por un estudiante -->
    <changeSet id="001" author="Mathias">
        <createTable tableName="tutoria_reserva">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="tutoria_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="estudiante_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)" defaultValue="AGENDADA">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="002" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="tutoria_reserva" baseColumnNames="tutoria_id"
                referencedTableName="tutoria" referencedColumnNames="id"
                constraintName="fk_tutoria_reserva_tutoria"
                onDelete="CASCADE" onUpdate="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="tutoria_reserva" baseColumnNames="estudiante_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_tutoria_reserva_estudiante"
                onDelete="CASCADE" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="003" author="Mathias">
        <sql>CREATE UNIQUE INDEX uk_tutoria_reserva_est ON tutoria_reserva(tutoria_id, estudiante_id) WHERE deleted_at IS NULL;</sql>
        <createIndex indexName="idx_tutoria_reserva_tutoria_id" tableName="tutoria_reserva">
            <column name="tutoria_id"/>
        </createIndex>
        <createIndex indexName="idx_tutoria_reserva_estudiante_id" tableName="tutoria_reserva">
            <column name="estudiante_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
