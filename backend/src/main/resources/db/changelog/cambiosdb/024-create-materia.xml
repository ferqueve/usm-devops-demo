<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Crear tabla materia (capa académica) -->
    <changeSet id="001" author="Mathias">
        <createTable tableName="materia">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="nombre" type="VARCHAR(150)">
                <constraints notNullConstraintName="nn_materia_nombre"/>
            </column>
            <column name="codigo" type="VARCHAR(20)"/>
            <column name="descripcion" type="TEXT"/>
            <column name="carrera_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="docente_id" type="BIGINT"/>
            <column name="semestre" type="INTEGER"/>
            <column name="creditos" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="002" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="materia" baseColumnNames="carrera_id"
                referencedTableName="carrera" referencedColumnNames="id"
                constraintName="fk_materia_carrera"
                onDelete="RESTRICT" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="003" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="materia" baseColumnNames="docente_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_materia_docente"
                onDelete="SET NULL" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="004" author="Mathias">
        <sql>CREATE UNIQUE INDEX uk_materia_codigo ON materia(codigo) WHERE codigo IS NOT NULL AND deleted_at IS NULL;</sql>
        <createIndex indexName="idx_materia_carrera_id" tableName="materia">
            <column name="carrera_id"/>
        </createIndex>
        <createIndex indexName="idx_materia_docente_id" tableName="materia">
            <column name="docente_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
