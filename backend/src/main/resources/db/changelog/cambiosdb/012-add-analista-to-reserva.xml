<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Agregar columna analista_id a tabla reserva -->
    <changeSet id="001" author="Mathias">
        <addColumn tableName="reserva">
            <column name="analista_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- Agregar foreign key constraint -->
    <changeSet id="002" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="reserva"
                baseColumnNames="analista_id"
                referencedTableName="usuario"
                referencedColumnNames="id"
                constraintName="fk_reserva_analista"
                onDelete="SET NULL"
                onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>

