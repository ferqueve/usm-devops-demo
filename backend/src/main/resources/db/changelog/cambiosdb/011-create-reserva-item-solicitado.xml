<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Crear tabla reserva_item_solicitado -->
    <changeSet id="001" author="Mathias">
        <createTable tableName="reserva_item_solicitado">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="reserva_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo_elemento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="inventario_item_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="cantidad_solicitada" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="observaciones" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Agregar foreign keys -->
    <changeSet id="002" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="reserva_item_solicitado"
                baseColumnNames="reserva_id"
                referencedTableName="reserva"
                referencedColumnNames="id"
                constraintName="fk_reserva_item_solicitado_reserva"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="003" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="reserva_item_solicitado"
                baseColumnNames="tipo_elemento_id"
                referencedTableName="tipo_elemento"
                referencedColumnNames="id"
                constraintName="fk_reserva_item_solicitado_tipo_elemento"
                onDelete="RESTRICT"
                onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="004" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="reserva_item_solicitado"
                baseColumnNames="inventario_item_id"
                referencedTableName="inventario_item"
                referencedColumnNames="id"
                constraintName="fk_reserva_item_solicitado_inventario_item"
                onDelete="SET NULL"
                onUpdate="CASCADE"/>
    </changeSet>

    <!-- Agregar índice para búsquedas por reserva -->
    <changeSet id="005" author="Mathias">
        <createIndex indexName="idx_reserva_item_solicitado_reserva_id"
                     tableName="reserva_item_solicitado">
            <column name="reserva_id"/>
        </createIndex>
    </changeSet>

    <!-- Agregar índice para búsquedas por estado -->
    <changeSet id="006" author="Mathias">
        <createIndex indexName="idx_reserva_item_solicitado_estado"
                     tableName="reserva_item_solicitado">
            <column name="estado"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

