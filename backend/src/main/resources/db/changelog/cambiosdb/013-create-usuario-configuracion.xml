<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Crear tabla usuario_configuracion -->
    <changeSet id="013-001" author="Mathias">
        <createTable tableName="usuario_configuracion">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints notNullConstraintName="nn_config_usuario_id" 
                             uniqueConstraintName="uk_config_usuario_id" 
                             foreignKeyName="fk_config_usuario" 
                             references="usuario(id)"/>
            </column>
            <column name="preferencias" type="JSONB">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_config_created_at"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_config_updated_at"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Crear índice para búsquedas por usuario_id -->
    <changeSet id="013-002" author="Mathias">
        <createIndex indexName="idx_config_usuario_id" tableName="usuario_configuracion">
            <column name="usuario_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

