<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Inscripción de usuarios a eventos -->
    <changeSet id="001" author="Mathias">
        <createTable tableName="evento_inscripcion">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="evento_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="estado" type="VARCHAR(20)" defaultValue="INSCRITO">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="002" author="Mathias">
        <addForeignKeyConstraint
                baseTableName="evento_inscripcion" baseColumnNames="evento_id"
                referencedTableName="evento" referencedColumnNames="id"
                constraintName="fk_evento_inscripcion_evento"
                onDelete="CASCADE" onUpdate="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="evento_inscripcion" baseColumnNames="usuario_id"
                referencedTableName="usuario" referencedColumnNames="id"
                constraintName="fk_evento_inscripcion_usuario"
                onDelete="CASCADE" onUpdate="CASCADE"/>
    </changeSet>

    <changeSet id="003" author="Mathias">
        <sql>CREATE UNIQUE INDEX uk_evento_inscripcion_usuario ON evento_inscripcion(evento_id, usuario_id) WHERE deleted_at IS NULL;</sql>
        <createIndex indexName="idx_evento_inscripcion_evento_id" tableName="evento_inscripcion">
            <column name="evento_id"/>
        </createIndex>
        <createIndex indexName="idx_evento_inscripcion_usuario_id" tableName="evento_inscripcion">
            <column name="usuario_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
