        </insert>
        <insert tableName="tipo_espacio">
            <column name="nombre" value="Sala de Reuniones"/>
            <column name="descripcion" value="Sala para reuniones y trabajo en equipo"/>
        </insert>
        <insert tableName="tipo_espacio">
            <column name="nombre" value="Oficina"/>
            <column name="descripcion" value="Oficina individual o compartida"/>
        </insert>
        <insert tableName="tipo_espacio">
            <column name="nombre" value="Biblioteca"/>
            <column name="descripcion" value="Espacio de biblioteca y estudio"/>
        </insert>
        <insert tableName="tipo_espacio">
            <column name="nombre" value="Taller"/>
