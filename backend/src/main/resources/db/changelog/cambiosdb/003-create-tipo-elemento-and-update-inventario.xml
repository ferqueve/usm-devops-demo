<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Crear tabla tipo_espacio -->
    <changeSet id="001" author="mathi">
        <createTable tableName="tipo_espacio">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints notNullConstraintName="nn_tipo_espacio_nombre" uniqueConstraintName="uk_tipo_espacio_nombre"/>
            </column>
            <column name="descripcion" type="TEXT"/>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints notNullConstraintName="nn_tipo_espacio_activo"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_tipo_espacio_created_at"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_tipo_espacio_updated_at"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Agregar columna tipo_espacio_id a espacio -->
    <changeSet id="002" author="mathi">
        <addColumn tableName="espacio">
            <column name="tipo_espacio_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- Agregar foreign key constraint para tipo_espacio_id -->
    <changeSet id="003" author="mathi">
        <addForeignKeyConstraint baseTableName="espacio"
                                 baseColumnNames="tipo_espacio_id"
                                 constraintName="fk_espacio_tipo_espacio"
                                 referencedTableName="tipo_espacio"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Agregar columna deleted_at a espacio -->
    <changeSet id="004" author="mathi">
        <addColumn tableName="espacio">
            <column name="deleted_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!-- Crear tabla tipo_elemento -->
    <changeSet id="005" author="mathi">
        <createTable tableName="tipo_elemento">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="nombre" type="VARCHAR(100)">
                <constraints notNullConstraintName="nn_tipo_elemento_nombre" uniqueConstraintName="uk_tipo_elemento_nombre"/>
            </column>
            <column name="descripcion" type="TEXT"/>
            <column name="activo" type="BOOLEAN" defaultValueBoolean="true">
                <constraints notNullConstraintName="nn_tipo_elemento_activo"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_tipo_elemento_created_at"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_tipo_elemento_updated_at"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- Agregar columna tipo_elemento_id a inventario_item -->
    <changeSet id="006" author="mathi">
        <addColumn tableName="inventario_item">
            <column name="tipo_elemento_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- Agregar foreign key constraint para tipo_elemento_id -->
    <changeSet id="007" author="mathi">
        <addForeignKeyConstraint baseTableName="inventario_item"
                                 baseColumnNames="tipo_elemento_id"
                                 constraintName="fk_inventario_tipo_elemento"
                                 referencedTableName="tipo_elemento"
                                 referencedColumnNames="id"/>
    </changeSet>

    <!-- Agregar nuevas columnas a inventario_item -->
    <changeSet id="008" author="mathi">
        <addColumn tableName="inventario_item">
            <column name="marca" type="VARCHAR(100)"/>
            <column name="modelo" type="VARCHAR(100)"/>
            <column name="numero_serie" type="VARCHAR(100)"/>
            <column name="estado" type="VARCHAR(20)" defaultValue="DISPONIBLE">
                <constraints notNullConstraintName="nn_inventario_estado"/>
            </column>
            <column name="observaciones" type="TEXT"/>
            <column name="fecha_adquisicion" type="DATE"/>
            <column name="valor_estimado" type="DECIMAL(10,2)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_inventario_created_at"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints notNullConstraintName="nn_inventario_updated_at"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!-- Eliminar columna tipo antigua de inventario_item -->
    <changeSet id="009" author="mathi">
        <dropColumn tableName="inventario_item" columnName="tipo"/>
    </changeSet>

</databaseChangeLog>
