        </insert>
    </changeSet>

    <!-- Insertar tipos básicos de elementos -->
    <changeSet id="011" author="mathi">
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Silla"/>
            <column name="descripcion" value="Silla individual para estudiantes"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Mesa"/>
            <column name="descripcion" value="Mesa individual o grupal"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Escritorio"/>
            <column name="descripcion" value="Escritorio para profesor"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Pizarra"/>
            <column name="descripcion" value="Pizarra blanca o verde"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Proyector"/>
            <column name="descripcion" value="Proyector multimedia"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Pantalla"/>
            <column name="descripcion" value="Pantalla de proyección"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Televisor"/>
            <column name="descripcion" value="Televisor LED/LCD"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Computadora"/>
            <column name="descripcion" value="PC de escritorio"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Sistema de Audio"/>
            <column name="descripcion" value="Sistema de sonido"/>
        </insert>
        <insert tableName="tipo_elemento">
            <column name="nombre" value="Aire Acondicionado"/>
            <column name="descripcion" value="Sistema de climatización"/>
        </insert>
    </changeSet>

</databaseChangeLog>
