# Conexión Postgres compartida con el backend.
# En Railway alcanza con DATABASE_URL inyectada por el plugin de Postgres.
DATABASE_URL=postgresql://ut_user:postgres@localhost:5432/utec_db

# Alternativa: variables sueltas
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=utec_db
# DB_USER=ut_user
# DB_PASSWORD=

PORT=8000
LOG_LEVEL=INFO
