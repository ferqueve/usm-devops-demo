# ===== UTEC SPACE MANAGER - FRONTEND - DESARROLLO LOCAL =====
# Este archivo es una plantilla para desarrollo local del frontend
# 
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Completa los valores según tu entorno
# 3. NUNCA commitear el archivo .env (debe estar en .gitignore)
#
# NOTA IMPORTANTE:
# Si usas 'npm run dev:network', el script setup-env.js
# sobrescribirá este archivo automáticamente con la IP de red detectada.

# ===== API BACKEND =====
# URL del backend (API REST)
# En desarrollo local:
VITE_API_URL=http://localhost:8080/api/v1
# En red local (si usas dev:network, se auto-detecta):
# VITE_API_URL=http://192.168.x.x:8080/api/v1

# ===== GOOGLE OAUTH 2.0 =====
# Client ID de Google OAuth (solo la parte pública)
# Debe ser el MISMO Client ID que usas en el backend
# 
# Obtén este valor de Google Cloud Console:
# https://console.cloud.google.com/ > Credentials
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# ===== FRONTEND URL (opcional) =====
# URL del frontend (usado en algunos casos para redirects)
# VITE_FRONTEND_URL=http://localhost:5173

