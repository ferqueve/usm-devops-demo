# ===== UTEC SPACE MANAGER - FRONTEND =====
# Solo las variables con prefijo VITE_ van aquí (Vite las expone al navegador).
# El resto (Gmail, JWT, BD, Redis, MinIO, etc.) van en backend/.env.
#
# Este archivo se genera automáticamente con el script setup-env.js
# INSTRUCCIONES:
# 1. Para desarrollo local: npm run dev (localhost) o npm run dev:network (red)
# 2. El script setup-env.js genera este archivo automáticamente
# 3. Para Docker: las variables se pasan desde docker-compose.yml
#
# NOTA: Para Google OAuth usa el MISMO GOOGLE_CLIENT_ID que en backend/.env (aquí como VITE_GOOGLE_CLIENT_ID).

# ===== VARIABLES GENERADAS AUTOMÁTICAMENTE =====
# Estas variables se configuran automáticamente por el script setup-env.js
VITE_API_URL=http://localhost:8080/api/v1
VITE_FRONTEND_URL=http://localhost:5173

# ===== GOOGLE OAUTH 2.0 =====
# IMPORTANTE: Debe ser el MISMO CLIENT_ID que en backend/.env
# Obtén las credenciales en: https://console.cloud.google.com/
# 
# Configuración en Google Cloud Console:
# - Authorized JavaScript origins: http://localhost:5173
# - Authorized redirect URIs: http://localhost:8080/api/v1/oauth2/google/callback
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

