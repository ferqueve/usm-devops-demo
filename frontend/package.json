    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "msw": "^2.14.5",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.8.3",
