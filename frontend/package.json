    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-day-picker": "^9.9.0",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12"
